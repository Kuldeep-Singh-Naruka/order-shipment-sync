{
  "name": "order-shipment-sync",
  "version": "1.0.0",
  "private": true,
  "description": "Receives orders/create webhooks and creates shipments with an unreliable courier API",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "courier": "node mock-courier.js",
    "dev": "node scripts/dev.js",
    "send-webhook": "node scripts/send-webhook.js",
    "reconcile": "node scripts/reconcile.js",
    "dead:list": "node scripts/dead-jobs.js list",
    "dead:replay": "node scripts/dead-jobs.js replay",
    "test": "node --test"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "dotenv": "^18.0.10",
    "express": "^5.3.0"
  }
